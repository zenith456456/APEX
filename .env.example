APP_NAME=binance-signal-bot
PORT=8080
LOG_LEVEL=INFO
BINANCE_WS_URL=wss://fstream.binance.com/public/stream
BINANCE_WS_API_URL=wss://ws-fapi.binance.com/ws-fapi/v1
BINANCE_REST_URL=https://fapi.binance.com
MAX_SYMBOLS=100
WS_SYMBOLS_PER_CONNECTION=8
WS_RECONFIGURE_MIN_SECONDS=120
MIN_24H_QUOTE_VOLUME=5000000
MIN_MOVER_24H_PCT=2.0
MOVER_SLOTS=50
VOLUME_SLOTS=75
EXCHANGE_INFO_REFRESH_SECONDS=300
UNIVERSE_REFRESH_SECONDS=60
ANALYSIS_INTERVAL_SECONDS=5
KLINE_LIMIT=200
SCORE_THRESHOLD=90
MIN_RR=3
RISK_PER_TRADE_PCT=1
DB_PATH=./data/signals.sqlite3
NEWS_ENABLED=true
NEWS_REFRESH_SECONDS=60
NEWS_LOOKBACK_MINUTES=30
NEWS_BLOCK_WORDS=hack,exploit,halt,delist,delisting,bankrupt,insolvency,lawsuit,sec,investigation
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=
